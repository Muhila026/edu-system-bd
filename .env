# Server
PORT=8000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=school_management
DB_USER=root
DB_PASSWORD=password

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Default Super Admin (seeded automatically on first server start)
SUPER_ADMIN_NAME=Admin Smith
SUPER_ADMIN_EMAIL=admin@edu.com
SUPER_ADMIN_PASSWORD=admin123

# Optional demo accounts also seeded on first start, for continuity with the
# existing frontend demo (set to "false" to skip seeding these)
SEED_DEMO_ACCOUNTS=true
